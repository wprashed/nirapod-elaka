# =============================================================
# NirapodElaka — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================

# ----- Database -----------------------------------------------
# PostgreSQL connection string (with PostGIS extension enabled)
DATABASE_URL="postgresql://nirapod:password@localhost:5432/nirapod_elaka"

# ----- Authentication -----------------------------------------
# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Email provider (for magic-link auth)
# Use a transactional email service like Resend, Postmark, or SMTP
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="noreply@example.com"
EMAIL_SERVER_PASSWORD="your-smtp-password"
EMAIL_FROM="NirapodElaka <noreply@example.com>"

# ----- Image Storage (Cloudflare R2) --------------------------
# R2 is S3-compatible. Find these in your Cloudflare dashboard.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="nirapod-elaka-uploads"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
# For local dev, set USE_LOCAL_STORAGE=true to skip R2
USE_LOCAL_STORAGE="true"

# ----- Rate Limiting ------------------------------------------
# Anonymous report submissions per hour per IP
RATE_LIMIT_ANONYMOUS_REPORTS_PER_HOUR="5"
# Verification events per hour per IP (anonymous)
RATE_LIMIT_ANONYMOUS_VERIFICATIONS_PER_HOUR="20"

# ----- Map / Tile Server --------------------------------------
# OpenStreetMap tiles — free, attribution required.
# For production, use your own tile server or a hosted provider.
# Default uses public OSM tiles (rate-limited, for dev only).
NEXT_PUBLIC_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'

# ----- Map Defaults (Dhaka, Bangladesh) -----------------------
NEXT_PUBLIC_DEFAULT_LAT="23.8103"
NEXT_PUBLIC_DEFAULT_LNG="90.4125"
NEXT_PUBLIC_DEFAULT_ZOOM="12"

# ----- Application Config ------------------------------------
NEXT_PUBLIC_APP_NAME="NirapodElaka"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to "true" in development to show DEMO DATA banners
NEXT_PUBLIC_DEMO_MODE="true"
# Data retention: days before resolved reports are archived
ARCHIVE_RESOLVED_AFTER_DAYS="30"
# Max upload file size in bytes (default: 5 MB)
MAX_UPLOAD_BYTES="5242880"
